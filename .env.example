# Porta HTTP publicada pela VPS.
HTTP_PORT=8080

# Porta onde o elfldr escuta no PS5.
ELFLDR_PORT=9021

# Endereco do PS5 alcancavel A PARTIR DA VPS/container.
# Recomendado: IP de uma VPN privada entre a VPS e sua rede.
# Se ficar vazio, o servidor tentara usar o IP de origem da requisicao HTTP.
PS5_HOST=
